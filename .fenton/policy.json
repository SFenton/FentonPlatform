{
  "schema_version": "1",
  "version": "0.3.0",
  "trusted_root_required": true,
  "trusted_runner": "installed-pinned-release",
  "trusted_reviewers": [],
  "protected_reviewers": [],
  "fixture_generation": "synthetic-v1",
  "build_identity": "local",
  "protected_paths": [
    ".fenton/policy.json",
    ".fenton/repo.json",
    ".fenton/models.json",
    ".fenton/runtime.json",
    "contracts/schemas/",
    "evals/graders/",
    ".github/workflows/",
    ".github/agents/",
    ".claude/agents/",
    "agents/",
    "pyproject.toml",
    "source-license-manifest.json",
    "integrations/dependencies/",
    "tools/check-docs.mjs",
    "tools/check-dependencies.mjs",
    "tools/check-dependencies.test.mjs",
    "tooling/tests/",
    "tooling/src/fenton_tooling/"
  ],
  "acceptance": {
    "require_exact_sha": true,
    "require_independent_review": true,
    "require_executed_tests": true
  },
  "authority": {
    "cross_repo": false,
    "production": false,
    "automatic_promotion": false,
    "provider_calls": false
  }
}
